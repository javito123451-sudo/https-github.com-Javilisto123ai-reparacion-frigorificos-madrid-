<section class="hero"><div class="wrap">
  {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
  <h1>{{ section.settings.title }}</h1>
  <p class="lead">{{ section.settings.text }}</p>
  <p>{% if section.settings.cta_label != blank %}<a class="btn" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>{% endif %}
     {% if section.settings.cta2_label != blank %}<a class="btn btn-ghost" href="{{ section.settings.cta2_url }}">{{ section.settings.cta2_label }}</a>{% endif %}</p>
</div></section>
{% schema %}
{ "name": "Hero", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Sobretítulo" },
  { "type": "text", "id": "title", "label": "Título", "default": "Tu empresa, conectada" },
  { "type": "textarea", "id": "text", "label": "Texto" },
  { "type": "text", "id": "cta_label", "label": "Botón 1" }, { "type": "url", "id": "cta_url", "label": "Enlace 1" },
  { "type": "text", "id": "cta2_label", "label": "Botón 2" }, { "type": "url", "id": "cta2_url", "label": "Enlace 2" }
], "presets": [{ "name": "Hero" }] }
{% endschema %}
