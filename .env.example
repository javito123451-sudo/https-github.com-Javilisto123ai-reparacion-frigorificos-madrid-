# Clave de la API de Claude (obligatoria para el análisis con IA). NUNCA la subas al repositorio.
ANTHROPIC_API_KEY=
# Modelo (por defecto claude-opus-5-5)
FG_MODEL=claude-opus-5-5
FG_DB=data/fraudguard.db
FG_RETENTION_DAYS=30
FG_RATE_PER_HOUR=30
FG_DAILY_LLM_CALLS=500
# En producción tras HTTPS:
FG_SECURE_COOKIES=true
