# Clave de la API de OpenAI (obligatoria para el análisis con IA). NUNCA la subas al repositorio.
OPENAI_API_KEY=
# Modelo con visión y salida estructurada (por defecto gpt-4o)
FG_MODEL=gpt-4o
FG_DB=data/fraudguard.db
FG_RETENTION_DAYS=30
FG_RATE_PER_HOUR=30
FG_DAILY_LLM_CALLS=500
# En producción tras HTTPS:
FG_SECURE_COOKIES=true
